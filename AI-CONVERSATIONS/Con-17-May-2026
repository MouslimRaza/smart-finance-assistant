FUNCTION create_savings_calculator_tool(income, expenses, goal):

  CONVERT all to float
  IF income <= 0: RETURN income error message
  IF expenses < 0: RETURN expenses error message
  IF goal <= 0: RETURN goal error message

  SET monthly to income minus expenses
  IF monthly <= 0:
    SET shortfall to absolute value of monthly
    RETURN shortfall error message

  SET months_total to goal divided by monthly
  SET years       to FLOOR of months_total divided by 12
  SET months_rem  to FLOOR of months_total modulo 12 plus 1
  SET weekly      to monthly divided by 4.33
  SET daily       to monthly divided by 30
  SET rate        to monthly divided by income times 100

  BUILD formatted report as list of lines
  RETURN lines joined with newline


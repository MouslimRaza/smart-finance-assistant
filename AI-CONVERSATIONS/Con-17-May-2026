FUNCTION chat_finbot(user_msg, spending_ctx empty string):

  SET system to SYSTEM_PROMPT
  IF spending_ctx not empty:
    APPEND newline + spending context to system

  TRY:
    SET reply to get_response(user_msg, system=system)
    IF reply is empty: SET reply to fallback message

  CATCH any Exception as e:
    SET reply to error message listing possible causes:
      Internet issue, API key invalid, server unavailable

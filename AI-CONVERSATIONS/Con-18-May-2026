def create_savings_calculator_tool(income, expenses, goal):
    income, expenses, goal = float(income), float(expenses), float(goal)
    if income   <= 0: return "Monthly income must be greater than zero."
    if expenses <  0: return "Expenses cannot be negative."
    if goal     <= 0: return "Goal must be greater than zero."
    monthly = income - expenses
    if monthly <= 0:
        shortfall = abs(monthly)
        return f"Spending ${shortfall:.2f} more than earned each month. Reduce expenses to start saving."
    months = goal / monthly
    yrs, mth = int(months // 12), int(months % 12) + 1
    rate, weekly, daily = monthly/income*100, monthly/4.33, monthly/30
    lines = [
        "=" * 51,
        "          SAVINGS GOAL CALCULATOR",
        "=" * 51,
        f"  Monthly Income    : ${income:>10.2f}",
        f"  Monthly Expenses  : ${expenses:>10.2f}",
        f"  Monthly Savings   : ${monthly:>10.2f}  ({rate:.1f}%)",
        f"  Savings Goal      : ${goal:>10.2f}",
        "",
        f"  Time to goal: {yrs} year(s) and {mth} month(s)" if yrs
        else f"  Time to goal: {mth} month(s)",
        f"  Per Week: ${weekly:.2f}  |  Per Day: ${daily:.2f}",
        "",
        f"  {rate:.1f}% savings rate — above the recommended 20% benchmark!" if rate >= 20
        else f"  {rate:.1f}% savings rate — aim for 20% by reducing gaming and café spending.",
        "=" * 51,
    ]
    return "\n".join(lines)

